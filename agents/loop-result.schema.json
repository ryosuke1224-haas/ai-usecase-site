{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-agent-loop-v1",
  "title": "Atlas agent loop result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disposition",
    "task",
    "iterations_used",
    "max_iterations",
    "files_changed",
    "qa_result",
    "unresolved_issues",
    "evaluator_result",
    "git_diff_summary",
    "committed"
  ],
  "properties": {
    "schema_version": { "const": "atlas-agent-loop-v1" },
    "disposition": {
      "enum": ["READY_FOR_HUMAN_REVIEW", "HUMAN_REVIEW_REQUIRED"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "path"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "iterations_used": { "type": "integer", "minimum": 0, "maximum": 3 },
    "max_iterations": { "type": "integer", "minimum": 1, "maximum": 3 },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "qa_result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "status",
        "tests_passed",
        "tests_failed",
        "tests_skipped",
        "report"
      ],
      "properties": {
        "status": { "enum": ["pass", "fail", "blocked", "not_run"] },
        "tests_passed": { "type": "integer", "minimum": 0 },
        "tests_failed": { "type": "integer", "minimum": 0 },
        "tests_skipped": { "type": "integer", "minimum": 0 },
        "report": { "type": ["string", "null"] }
      }
    },
    "unresolved_issues": {
      "type": "array",
      "items": { "$ref": "qa-failure.schema.json" }
    },
    "evaluator_result": {
      "oneOf": [
        { "$ref": "evaluator-hook.schema.json" },
        { "type": "null" }
      ]
    },
    "git_diff_summary": { "type": "string" },
    "committed": { "const": false },
    "iterations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["iteration", "builder_invocation", "builder_report"],
        "properties": {
          "iteration": { "type": "integer", "minimum": 1, "maximum": 3 },
          "builder_invocation": { "type": "string" },
          "builder_command": { "type": "string" },
          "builder_report": { "type": "string" },
          "validate": { "type": "string" },
          "build": { "type": "string" },
          "qa_report": { "type": ["string", "null"] }
        }
      }
    },
    "builder_invocation": { "type": "string" },
    "builder_command": { "type": "string" },
    "fallback_used": { "type": "boolean" },
    "authenticated_session": {
      "enum": ["reused", "not_required", "missing"]
    },
    "loop_report": { "type": "string" }
  }
}
