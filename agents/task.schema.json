{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-agent-task-v1",
  "title": "Atlas agent task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "objective",
    "target_use_case",
    "scope",
    "acceptance_criteria",
    "forbidden_changes",
    "requires_authenticated_qa",
    "max_iterations"
  ],
  "properties": {
    "schema_version": { "const": "atlas-agent-task-v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable task id. Used in reports. Not a secret."
    },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "target_use_case": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Repo-relative files or directory prefixes the Builder may change."
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_changes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "permits_qa_changes": {
      "type": "boolean",
      "default": false,
      "description": "When false, the Builder must not edit tests or QA infrastructure."
    },
    "requires_authenticated_qa": { "type": "boolean" },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    }
  }
}
